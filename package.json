{
  "name": "mint-tea-website",
  "version": "1.0.0",
  "description": "Website for Mint Tea Records",
  "scripts": {
    "clean": "rm -rf dist/* dev/* && mkdir -p dist/media dev/media",
    "optimise-images": "node scripts/optimise-images.js",
    "start": "webpack serve --open --host 0.0.0.0 --config webpack.dev.config.js",
    "build-prod": "mkdir -p dist/media && node scripts/optimise-images.js && webpack --config webpack.prod.config.js",
    "build-dev": "mkdir -p dev/media && cp -r src/media/* dev/media && webpack --config webpack.dev.config.js --watch",
    "lint": "eslint src/**/*.js",
    "lint:fix": "eslint src/**/*.js --fix",
    "format": "prettier --write \"src/**/*.{js,css,html}\"",
    "format:check": "prettier --check \"src/**/*.{js,css,html}\""
  },
  "dependencies": {
    "three": "^0.144.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^6.7.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^9.1.0",
    "html-webpack-plugin": "^5.5.0",
    "prettier": "^3.3.0",
    "sharp": "^0.35.3",
    "source-map-loader": "^1.0.0",
    "style-loader": "^3.3.1",
    "webpack": "^5.70.0",
    "webpack-cli": "^7.2.1",
    "webpack-dev-server": "^6.0.0"
  }
}
